{
  "name": "@worldmonitor/redis-d1-proxy",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Upstash-REST-compatible Cloudflare Worker over D1 — free-tier replacement for Upstash Redis",
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir=dist",
    "db:create": "wrangler d1 create redis-d1-proxy",
    "db:migrate": "wrangler d1 execute redis-d1-proxy --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute redis-d1-proxy --local --file=schema.sql",
    "test": "node --test index.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.95.0"
  }
}
